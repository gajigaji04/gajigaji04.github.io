# ─────────────────────────────────────────────────────────────
# 커밋하면 안 되는 파일 목록
# 이유와 반대로 "꼭 커밋해야 하는 파일"은 docs/CONTENT_GUIDE.md 의 '깃에 올리는 파일' 참고
# ─────────────────────────────────────────────────────────────

# ── 빌드 결과물 (npm run build 로 언제든 다시 생성) ──────────
dist/
.astro/
# Pagefind 를 실수로 public/ 에 출력한 경우
public/pagefind/
*.tsbuildinfo
.cache/

# ── 의존성 (npm ci 로 package-lock.json 기준 재설치) ─────────
node_modules/

# ── 비밀 정보: 토큰 · 키 · 환경 변수 ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.npmrc

# ── 개인 원본 파일 (이력서 원본, 고해상도 사진, 초안 등) ─────
# 사이트에 실제로 올릴 파일만 public/ 또는 src/assets/ 에 둡니다.
_private/
*.psd
*.fig
*.sketch

# ── 로그 ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 테스트 · 측정 결과 ───────────────────────────────────────
coverage/
playwright-report/
test-results/
.lighthouseci/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── 에디터 · 도구 (개인 설정) ────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
# Claude Code 개인 설정 (공유 규칙은 CLAUDE.md 로 커밋)
.claude/settings.local.json
CLAUDE.md

# ── 이전 Jekyll 사이트 잔여물 (더 이상 사용 안 함) ───────────
_site/
.jekyll-cache/
.sass-cache/
.bundle/
vendor/
Gemfile.lock
