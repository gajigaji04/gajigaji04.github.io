---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import Cover from '../../components/Cover.astro';
import CodeEnhancer from '../../components/CodeEnhancer.astro';
import { getPosts, dotDate, readingMinutes, slugifyTag, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts(); // 최신순
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const minDepth = Math.min(...toc.map((h) => h.depth));
---
<BaseLayout title={d.title} description={d.description} type="article" publishedTime={d.date}>
  <div slot="top" class="progress" aria-hidden="true"><div data-progress></div></div>

  <article class="sec page-head" data-pagefind-body data-pagefind-meta="kind:blog">
    <a class="crumb" href="/blog/" data-pagefind-ignore><Icon name="arrowLeft" class="ico-xs" />Blog</a>

    <header class="dhead">
      <div class="meta">
        <a href={`/blog/?cat=${encodeURIComponent(d.category)}`} class="pill" style="color: var(--fg)">{d.category}</a>
        <time datetime={d.date.toISOString()}>{dotDate(d.date)}</time>
        {d.updated && <span>(수정 {dotDate(d.updated)})</span>}
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)}분</span>
        <SampleBadge show={d.sample} />
      </div>
      <h1 data-pagefind-meta="title">{d.title}</h1>
      <p class="sum">{d.description}</p>
      {
        d.tags.length > 0 && (
          <div class="meta" data-pagefind-ignore>
            {d.tags.map((t) => <a class="mono" href={`/blog/?tag=${encodeURIComponent(slugifyTag(t))}`}>#{slugifyTag(t)}</a>)}
          </div>
        )
      }
    </header>

    <div style="margin-top: 28px"><Cover kind="blog" id={post.id} title={d.title} label={d.category} eager imageOnly /></div>

    {
      toc.length > 1 && (
        <details class="toc" data-pagefind-ignore>
          <summary>On this page <Icon name="chevron" class="ico-sm chev" /></summary>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class:list={{ sub: h.depth > minDepth }}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose" data-prose>
      <Content />
    </div>

    <div class="share" data-pagefind-ignore>
      <button type="button" class="btn" data-copy-link><Icon name="link" class="ico-sm" /><span>링크 복사</span></button>
    </div>

    <nav class="pnav" aria-label="이전/다음 글" data-pagefind-ignore>
      {older ? <a href={`/blog/${older.id}/`}><span class="l">← 이전 글</span><span class="t">{older.data.title}</span></a> : <span></span>}
      {newer && <a class="next" href={`/blog/${newer.id}/`}><span class="l">다음 글 →</span><span class="t">{newer.data.title}</span></a>}
    </nav>
  </article>
  <CodeEnhancer />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const update = () => {
    if (!bar || !prose) return;
    const r = prose.getBoundingClientRect();
    const total = r.height - innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    bar.style.width = `${(p * 100).toFixed(1)}%`;
  };
  update();
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);

  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('span')!;
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      label.textContent = '복사됨';
    } catch {
      label.textContent = '복사 실패';
    }
    setTimeout(() => (label.textContent = '링크 복사'), 1600);
  });
</script>
