---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOW_BLOG } from '../data/profile';
---
<BaseLayout title="404" description="페이지를 찾을 수 없습니다." noindex>
  <section class="sec page-head" style="padding-bottom: 96px">
    <p class="mono muted" style="font-size: 13px">404</p>
    <h1 class="h1" style="margin-top: 8px">페이지를 찾을 수 없습니다</h1>
    <p class="lead">주소가 바뀌었거나 삭제된 페이지일 수 있습니다. <span class="mono" data-path></span></p>
    <div class="cta">
      <a class="btn pri" href="/">홈으로</a>
      <a class="btn" href="/projects/">Projects</a>
      {SHOW_BLOG && <a class="btn" href="/blog/">Blog</a>}
      <button class="btn" type="button" data-search-open>검색</button>
    </div>
  </section>
</BaseLayout>
<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = decodeURIComponent(location.pathname);
</script>
